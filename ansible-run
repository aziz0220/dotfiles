#!/usr/bin/env bash
set -euo pipefail

PLAYBOOK="${ANSIBLE_PLAYBOOK_FILE:-local.yml}"
TAG_SET="all"
REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
BOOTSTRAP_HOME_DIR="${BOOTSTRAP_HOME_DIR:-$REPO_DIR/.bootstrap/home}"
ENCRYPTED_HOME_BUNDLE="${ENCRYPTED_HOME_BUNDLE:-$REPO_DIR/vault/home-secrets.tar.gz.aes256}"

if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
  TAG_SET="$1"
  shift
fi

ANSIBLE_EXTRA_ARGS=("$@")

# Resolved before anything else, vault decryption included, because every later
# step acts on whoever this decides the target is.
#
# Identity is detected from the invoking shell, so `sudo ./ansible-run` used to
# detect root: user_name=root, user_home=/root, and a full run restored the
# vault -- SSH keys, GPG keys, cloud credentials, agent logins -- into root's
# home while reporting success. It also skipped the sudo-authentication check
# below, which is conditioned on not already being root.
#
# Refusing would be safe but unhelpful: people reach for sudo precisely because
# that check rejected them for lacking passwordless sudo. Adopting SUDO_USER
# instead makes `sudo ./ansible-run` do the obviously intended thing -- and it
# is the one invocation that already has the privileges the play needs, so it
# does not need -K at all. Genuine root with no SUDO_USER (containers, CI) is
# untouched.
TARGET_USER="$(whoami)"
if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
  if ! getent passwd "$SUDO_USER" >/dev/null 2>&1; then
    echo "ERROR: SUDO_USER=$SUDO_USER has no passwd entry; cannot resolve the target user." >&2
    exit 1
  fi
  TARGET_USER="$SUDO_USER"
  echo "NOTE: running under sudo; provisioning $TARGET_USER rather than root."
fi

if ! command -v ansible-playbook >/dev/null 2>&1; then
  echo "ERROR: ansible-playbook is not installed. Run ./install first." >&2
  exit 1
fi

# Only ./install pulls. Provisioning from a stale clone silently applies stale
# vars and a stale vault, so warn rather than pull: pulling here would swap the
# playbook out from under the run. Set DOTFILES_SKIP_FETCH=1 to stay offline.
if [ "${DOTFILES_SKIP_FETCH:-0}" != "1" ] &&
   git -C "$REPO_DIR" rev-parse '@{u}' >/dev/null 2>&1 &&
   git -C "$REPO_DIR" fetch --quiet 2>/dev/null; then
  behind="$(git -C "$REPO_DIR" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
  if [ "${behind:-0}" -gt 0 ]; then
    echo "WARNING: $REPO_DIR is $behind commit(s) behind upstream; provisioning from a stale state." >&2
    echo "         Run 'git -C $REPO_DIR pull --ff-only' first to use the latest vars and vault." >&2
  fi
fi

# The decrypted tree is a cache of the vault, so it has to be invalidated when
# the vault changes. Decrypting only when the directory was absent meant a
# `git pull` that brought a newer vault changed nothing: the stale tree was
# still there, so every later run restored the old secrets while reporting
# success. New credentials silently never arrived.
VAULT_STAMP="$BOOTSTRAP_HOME_DIR/../.vault-stamp"

vault_fingerprint() {
  sha256sum "$ENCRYPTED_HOME_BUNDLE" 2>/dev/null | awk '{print $1}'
}

# ./install prompts for the passphrase; this script only ever errored. That
# dead-ended the ordinary "delete the decrypted tree and rerun" path, where the
# vault is the sole source of the secrets being restored. Prompt when there is
# a terminal to prompt on, and keep failing loudly when there is not, so CI and
# other non-interactive callers behave exactly as before.
prompt_vault_password() {
  [ -t 0 ] || return 1
  [ -f "$ENCRYPTED_HOME_BUNDLE" ] || return 1
  local attempt
  # Retries, because the input is hidden: a keystroke that does not register
  # looks identical to one that does, and giving up after a single empty Enter
  # dropped through to a "missing bootstrap home" error that says nothing about
  # the passphrase that was actually being asked for.
  for attempt in 1 2 3; do
    printf 'Vault passphrase (input hidden): ' >&2
    read -r -s SETUP_SECRETS_PASSWORD
    printf '\n' >&2
    if [ -n "${SETUP_SECRETS_PASSWORD}" ]; then
      export SETUP_SECRETS_PASSWORD
      return 0
    fi
    if [ "$attempt" -lt 3 ]; then
      echo "Nothing entered. Type the passphrase and press Enter; no characters are shown." >&2
    fi
  done
  echo "No passphrase entered after 3 attempts." >&2
  return 1
}

bootstrap_home_is_stale() {
  [ -f "$ENCRYPTED_HOME_BUNDLE" ] || return 1
  if [ -f "$VAULT_STAMP" ]; then
    [ "$(vault_fingerprint)" != "$(cat "$VAULT_STAMP" 2>/dev/null)" ]
  else
    # No stamp: the tree predates stamping, or a capture wrote it. Only the
    # first case needs refreshing, and a vault newer than the tree is what
    # distinguishes them -- after a capture the tree is the newer of the two.
    [ "$ENCRYPTED_HOME_BUNDLE" -nt "$BOOTSTRAP_HOME_DIR" ]
  fi
}

if [ ! -d "$BOOTSTRAP_HOME_DIR" ]; then
  if [ -f "$ENCRYPTED_HOME_BUNDLE" ]; then
    if [ -z "${SETUP_SECRETS_PASSWORD-}" ] && ! prompt_vault_password; then
      echo "ERROR: missing $BOOTSTRAP_HOME_DIR and encrypted bundle exists at $ENCRYPTED_HOME_BUNDLE." >&2
      echo "Set SETUP_SECRETS_PASSWORD and rerun ./ansible-run to decrypt automatically." >&2
      exit 1
    fi
    "$REPO_DIR/scripts/decrypt_home_bundle.sh" "$ENCRYPTED_HOME_BUNDLE" "$BOOTSTRAP_HOME_DIR" "SETUP_SECRETS_PASSWORD"
    vault_fingerprint > "$VAULT_STAMP"
  else
    echo "ERROR: missing bootstrap home source at $BOOTSTRAP_HOME_DIR." >&2
    echo "Create it or provide an encrypted bundle at $ENCRYPTED_HOME_BUNDLE." >&2
    exit 1
  fi
elif bootstrap_home_is_stale; then
  if [ -z "${SETUP_SECRETS_PASSWORD-}" ]; then
    echo "NOTE: the vault changed since $BOOTSTRAP_HOME_DIR was decrypted." >&2
    prompt_vault_password || true
  fi
  if [ -n "${SETUP_SECRETS_PASSWORD-}" ]; then
    echo "NOTE: the vault changed since $BOOTSTRAP_HOME_DIR was decrypted; refreshing it."
    "$REPO_DIR/scripts/decrypt_home_bundle.sh" "$ENCRYPTED_HOME_BUNDLE" "$BOOTSTRAP_HOME_DIR" "SETUP_SECRETS_PASSWORD"
    vault_fingerprint > "$VAULT_STAMP"
  else
    echo "WARNING: the vault is newer than $BOOTSTRAP_HOME_DIR, which will restore stale secrets." >&2
    echo "         Set SETUP_SECRETS_PASSWORD to refresh it, or delete that directory and rerun." >&2
  fi
fi

# Read from passwd rather than $HOME/$UID, which describe the invoking process
# and are root's when this runs under sudo.
CURRENT_USER="$TARGET_USER"
CURRENT_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
CURRENT_UID="$(id -u "$TARGET_USER")"
CURRENT_GID="$(id -g "$TARGET_USER")"

if [ -z "$CURRENT_HOME" ]; then
  echo "ERROR: could not resolve a home directory for $TARGET_USER." >&2
  exit 1
fi
# Identity is detected; the login shell deliberately is not. $SHELL is whatever
# shell happens to be invoking this -- on a fresh Ubuntu that is bash, and
# passing it as -e overrode the zsh in vars/user-profile.yml, so provisioning
# set the account back to bash every time. The desired shell is configuration,
# not an ambient property of the current terminal, so it stays in vars.
ANSIBLE_CMD=(
  ansible-playbook "$PLAYBOOK"
  -e "user_name=$CURRENT_USER"
  -e "user_home=$CURRENT_HOME"
  -e "user_uid=$CURRENT_UID"
  -e "user_gid=$CURRENT_GID"
)

if [ "$TAG_SET" != "all" ]; then
  ANSIBLE_CMD+=(--tags "$TAG_SET")
fi

ANSIBLE_CMD+=("${ANSIBLE_EXTRA_ARGS[@]}")

if [ "$(id -u)" -ne 0 ]; then
  if command -v sudo >/dev/null 2>&1; then
    ask_become_pass=false
    for arg in "${ANSIBLE_EXTRA_ARGS[@]}"; do
      if [ "$arg" = "-K" ] || [ "$arg" = "--ask-become-pass" ]; then
        ask_become_pass=true
        break
      fi
    done

    if [ "$ask_become_pass" = false ]; then
      if ! sudo -n true; then
        echo "ERROR: sudo needs authentication. Rerun with --ask-become-pass or authenticate with sudo first." >&2
        exit 1
      fi
    fi
  else
    echo "ERROR: sudo is required for become tasks." >&2
    exit 1
  fi
fi

echo "Bootstrapping as user: $CURRENT_USER ($CURRENT_HOME)"
"${ANSIBLE_CMD[@]}"
